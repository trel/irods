# Build rule for target.
irods_union_types: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 irods_union_types
.PHONY : irods_union_types

# fast build rule for target.
irods_union_types/fast:
	$(MAKE) $(MAKESILENT) -f unit_tests/CMakeFiles/irods_union_types.dir/build.make unit_tests/CMakeFiles/irods_union_types.dir/build
.PHONY : irods_union_types/fast

